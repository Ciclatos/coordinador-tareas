{
  "name": "coordinador-tareas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "pdf:inspect-reference": "node scripts/inspect-reference.mjs",
    "pdf:qa": "tsx scripts/generate-pdf-qa.ts && node scripts/verify-pdf.mjs output/pdf/qa-30-pages.pdf 30",
    "image:qa": "tsx scripts/generate-distribution-image-qa.ts",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "storage:audit": "node --env-file=.env.local --import tsx scripts/storage-audit.ts",
    "storage:cleanup:preview": "npm run storage:audit -- --cleanup-orphans"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.6.0",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "nanoid": "^5.1.16",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.84.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
